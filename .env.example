# PostgreSQL Database Configuration
POSTGRES_USER=Saharsh
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=patent_rag_db
DATABASE_URL=postgresql+asyncpg://localhost:5432/patent_rag_db

# OpenAI API Settings
